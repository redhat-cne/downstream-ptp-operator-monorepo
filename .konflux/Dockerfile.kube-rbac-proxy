ARG BUILDER_IMAGE=brew.registry.redhat.io/rh-osbs/openshift-golang-builder:rhel_9_golang_1.25
ARG RUNTIME_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal:latest

# Built with path-context pkg/kube-rbac-proxy (vendored openshift/kube-rbac-proxy).
# Do not use Dockerfile.ocp: its registry.ci.openshift.org FROM lines are not
# available to Konflux. go build is used instead of `make build` because the
# vendored tree has no .git and the upstream Makefile calls git rev-parse.

FROM ${BUILDER_IMAGE} AS builder
USER root
WORKDIR /go/src/github.com/brancz/kube-rbac-proxy
COPY . .
ENV GO111MODULE=on
ENV GOFLAGS="-mod=vendor"
ENV CGO_ENABLED=0
RUN VERSION="$(cat VERSION)" && \
    COMMIT="$(cat .vendor-sha 2>/dev/null || echo vendored)" && \
    go build --installsuffix cgo \
      -ldflags="-X k8s.io/component-base/version.gitVersion=${VERSION} -X k8s.io/component-base/version.gitCommit=${COMMIT} -X k8s.io/component-base/version/verflag.programName=kube-rbac-proxy" \
      -o /tmp/kube-rbac-proxy \
      github.com/brancz/kube-rbac-proxy/cmd/kube-rbac-proxy

FROM ${RUNTIME_IMAGE}
COPY --from=builder /tmp/kube-rbac-proxy /usr/bin/kube-rbac-proxy

LABEL io.k8s.display-name="kube-rbac-proxy" \
      io.k8s.description="This is a proxy, that can perform Kubernetes RBAC authorization." \
      io.openshift.tags="openshift,kubernetes" \
      summary="" \
      maintainer="PTP Team <ptp-dev@redhat.com>"

USER 65534
EXPOSE 8080
ENTRYPOINT ["/usr/bin/kube-rbac-proxy"]
