ARG BUILDER_IMAGE=brew.registry.redhat.io/rh-osbs/openshift-golang-builder:rhel_9_golang_1.25
# UBI 9 runtime (Conforma-permitted, FIPS-certified). CentOS Stream repos supply
# operand RPMs not in the UBI public subset (linuxptp, synce4l, chrony).
ARG RUNTIME_IMAGE=registry.access.redhat.com/ubi9/ubi:9.6

# Built with path-context "." (repo root). Sources under pkg/linuxptp-daemon/.

FROM ${BUILDER_IMAGE} AS builder
USER root
WORKDIR /go/src/github.com/k8snetworkplumbingwg/linuxptp-daemon
COPY pkg/linuxptp-daemon/ .
RUN make clean && make

FROM ${RUNTIME_IMAGE}

COPY .konflux/rpms/linuxptp-daemon/centos-baseos.repo /etc/yum.repos.d/
COPY .konflux/rpms/linuxptp-daemon/centos-appstream.repo /etc/yum.repos.d/
COPY .konflux/rpms/linuxptp-daemon/RPM-GPG-KEY-centosofficial /etc/pki/rpm-gpg/

RUN yum -y update && yum -y update glibc && yum --setopt=skip_missing_names_on_install=False -y \
  install \
  pciutils \
  linuxptp \
  ethtool \
  hwdata \
  synce4l \
  iproute \
  procps-ng \
  chrony \
  && (yum -y install gpsd-minimal gpsd-minimal-clients || yum -y install gpsd gpsd-clients) \
  && yum clean all

RUN ln -s /usr/bin/gpspipe /usr/local/bin/gpspipe
RUN ln -s /usr/sbin/gpsd /usr/local/sbin/gpsd
RUN ln -s /usr/bin/ubxtool /usr/local/bin/ubxtool

COPY --from=builder /go/src/github.com/k8snetworkplumbingwg/linuxptp-daemon/bin/ptp /usr/local/bin/
COPY pkg/linuxptp-daemon/extra/leap-seconds.list /usr/share/zoneinfo/leap-seconds.list

CMD ["/usr/local/bin/ptp"]
