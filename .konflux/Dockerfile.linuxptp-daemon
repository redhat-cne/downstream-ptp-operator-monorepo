ARG BUILDER_IMAGE=brew.registry.redhat.io/rh-osbs/openshift-golang-builder:rhel_9_golang_1.25
ARG RUNTIME_IMAGE=registry.access.redhat.com/ubi9/ubi:latest

FROM ${BUILDER_IMAGE} AS builder
WORKDIR /go/src/github.com/k8snetworkplumbingwg/linuxptp-daemon
COPY . .
ENV GOEXPERIMENT=strictfipsruntime
ENV CGO_ENABLED=1
ENV GOFLAGS="-mod=vendor"
RUN make clean && make

FROM ${RUNTIME_IMAGE}

RUN yum --setopt=skip_missing_names_on_install=False -y \
  install \
  pciutils \
  linuxptp \
  ethtool \
  hwdata \
  synce4l \
  iproute \
  procps-ng \
  chrony \
  && yum clean all

RUN yum -y install gpsd-minimal gpsd-minimal-clients \
  || yum -y install gpsd gpsd-clients \
  || echo "WARN: gpsd packages not available due to systemd version mismatch, GPS support disabled"

RUN [ -f /usr/bin/gpspipe ] && ln -s /usr/bin/gpspipe /usr/local/bin/gpspipe || true
RUN [ -f /usr/sbin/gpsd ] && ln -s /usr/sbin/gpsd /usr/local/sbin/gpsd || true
RUN [ -f /usr/bin/ubxtool ] && ln -s /usr/bin/ubxtool /usr/local/bin/ubxtool || true

COPY --from=builder /go/src/github.com/k8snetworkplumbingwg/linuxptp-daemon/bin/ptp /usr/local/bin/
COPY ./extra/leap-seconds.list /usr/share/zoneinfo/leap-seconds.list

CMD ["/usr/local/bin/ptp"]
