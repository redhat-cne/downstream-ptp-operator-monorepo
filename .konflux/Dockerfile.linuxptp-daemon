ARG BUILDER_IMAGE=brew.registry.redhat.io/rh-osbs/openshift-golang-builder:rhel_9_golang_1.25
# Digest-pin ubi9/ubi. Must match rpms.in.yaml context.image. Do not set
# RUNTIME_IMAGE in the shared container_build_args.conf. Relock with
# scripts/relock-linuxptp-daemon-rpms.sh after changing this digest.
ARG RUNTIME_IMAGE=registry.access.redhat.com/ubi9/ubi@sha256:9295c5c688f487fa5cf27a734fa55ecd57aeb7dc0904ba537da4f42dfa1d0acb

# Built with path-context "." so Hermeto/cachi2 RPM injection (repo root) is
# visible to yum. Operand layout matches pkg/linuxptp-daemon/addons/redhat/Dockerfile.ocp.

FROM ${BUILDER_IMAGE} AS builder
USER root
WORKDIR /go/src/github.com/k8snetworkplumbingwg/linuxptp-daemon
COPY pkg/linuxptp-daemon/ .
RUN make clean && make

FROM ${RUNTIME_IMAGE}

# Do not `yum update`: hermetic yum only sees .konflux/rpms/linuxptp-daemon.
# Install libacl/systemd-libs/acl so locked EVRs from reinstallPackages resolve.
# allowed_downgrades is a safety net, not a substitute for locking util-linux,
# openssl, systemd, and hwdata to the NEVRAs already in this image.
RUN yum --setopt=skip_missing_names_on_install=False --setopt=allowed_downgrades=1 -y install \
      libacl \
      systemd-libs \
      acl \
      pciutils \
      linuxptp \
      ethtool \
      hwdata \
      synce4l \
      iproute \
      procps-ng \
      chrony \
      gpsd-minimal \
      gpsd-minimal-clients \
 && yum clean all

RUN ln -s /usr/bin/gpspipe /usr/local/bin/gpspipe
RUN ln -s /usr/sbin/gpsd /usr/local/sbin/gpsd
RUN ln -s /usr/bin/ubxtool /usr/local/bin/ubxtool

COPY --from=builder /go/src/github.com/k8snetworkplumbingwg/linuxptp-daemon/bin/ptp /usr/local/bin/
COPY pkg/linuxptp-daemon/extra/leap-seconds.list /usr/share/zoneinfo/leap-seconds.list

CMD ["/usr/local/bin/ptp"]
